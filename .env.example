# ── Required ──
DOMAIN=app.yourdomain.com
ADMIN_SECRET=change-me-to-a-long-random-string
TG_API_ID=
TG_API_HASH=
TG_CHANNEL_IDS=-1001234567890
# For hosts without a persistent disk: run make_session.py once and paste its output here
TG_SESSION_STRING=
# ── Sign-in ──
# Optional: enables "Continue with Google". Create an OAuth Web client at console.cloud.google.com
# and add https://DOMAIN as an authorised JavaScript origin.
GOOGLE_CLIENT_ID=
SESSION_DAYS=30
# ── Business ──
POCKET_MASTER_ID=
USDT_TRC20_ADDRESS=
SIGNAL_TZ=UTC
REQUIRE_VERIFIED_BROKER=true
AUTO_CONFIRM_PAYMENTS=false   # never true in production
ONCHAIN_VERIFY=true           # verifies USDT TRC-20 payments on the TRON network
TRONGRID_API_KEY=             # optional, from trongrid.io
AUTO_CONFIRM_MAX=200          # larger payments wait for admin review
DEFAULT_PAYOUT_PCT=85         # payout used when results are settled automatically
# Support buttons (can also be set live in the admin Settings panel)
WHATSAPP_URL=https://wa.me/YOURNUMBER
TELEGRAM_URL=https://t.me/your_vip_channel
# ── Broker referral (registration) links and trading-terminal links ──
LINK_POCKET_OPTION=https://pocketoption.com/
LINK_QUOTEX=https://qxbroker.com/
LINK_IQ_OPTION=https://iqoption.com/
TRADE_POCKET_OPTION=https://pocketoption.com/en/cabinet/
TRADE_QUOTEX=https://qxbroker.com/en/trade
TRADE_IQ_OPTION=https://iqoption.com/traderoom
# ── Database: SQLite for a single server with a disk; on most hosts use the PostgreSQL URL they give you ──
# DATABASE_URL=postgres://user:pass@host:5432/db   (postgres:// and postgresql:// are accepted as is)
DATABASE_URL=sqlite+aiosqlite:////data/share_option.db
CORS_ORIGINS=https://app.yourdomain.com
